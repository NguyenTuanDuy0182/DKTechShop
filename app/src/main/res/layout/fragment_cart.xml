<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/md_theme_light_surface">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical"
        android:background="@color/md_theme_light_surface"
        android:elevation="1dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_cart_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Giỏ hàng"
                android:textColor="@color/md_theme_light_onSurface"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quản lý giỏ hàng"
                android:textColor="@color/md_theme_light_onSurfaceVariant"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_cart_freeship_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_banner_gradient"
            android:backgroundTint="@color/md_theme_light_tertiaryContainer"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:text="Freeship Toàn quốc"
            android:textColor="@color/md_theme_light_onTertiaryContainer"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_cart_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Shipping Address Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_shipping_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/md_theme_light_outlineVariant"
                app:cardBackgroundColor="@color/md_theme_light_surfaceContainerLow"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp"
                        app:cardBackgroundColor="@color/md_theme_light_primaryContainer">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_location"
                            app:tint="@color/md_theme_light_onPrimaryContainer"
                            android:contentDescription="Address icon" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_cart_user_info"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Tên người dùng • 0123456789"
                                android:textColor="@color/md_theme_light_onSurface"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Đổi"
                                android:textColor="@color/md_theme_light_primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_cart_address_detail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Địa chỉ nhận hàng"
                            android:textColor="@color/md_theme_light_onSurfaceVariant"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Cart Items Recycler -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="Sản phẩm đã chọn"
                android:textColor="@color/md_theme_light_onSurface"
                android:textSize="13sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_cart_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_cart" />

            <!-- Payment Methods Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:text="Phương thức thanh toán"
                android:textColor="@color/md_theme_light_onSurface"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layout_payment_methods"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- COD Option -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_pay_cod"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/md_theme_light_primary"
                    app:cardBackgroundColor="@color/md_theme_light_secondaryContainer"
                    android:clickable="true"
                    android:focusable="true">

                    <RadioButton
                        android:id="@+id/rb_pay_cod"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:clickable="false"
                        android:focusable="false"
                        android:padding="8dp"
                        android:text="Thanh toán khi nhận hàng (COD)"
                        android:textColor="@color/md_theme_light_onSurface"
                        android:textSize="12sp" />
                </com.google.android.material.card.MaterialCardView>

                <!-- VNPay Option -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_pay_vnpay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/md_theme_light_outlineVariant"
                    app:cardBackgroundColor="@color/md_theme_light_surfaceContainerLowest"
                    android:clickable="true"
                    android:focusable="true">

                    <RadioButton
                        android:id="@+id/rb_pay_vnpay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false"
                        android:padding="8dp"
                        android:text="VNPay / Chuyển khoản QR"
                        android:textColor="@color/md_theme_light_onSurface"
                        android:textSize="12sp" />
                </com.google.android.material.card.MaterialCardView>

                <!-- MoMo Option -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_pay_momo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/md_theme_light_outlineVariant"
                    app:cardBackgroundColor="@color/md_theme_light_surfaceContainerLowest"
                    android:clickable="true"
                    android:focusable="true">

                    <RadioButton
                        android:id="@+id/rb_pay_momo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false"
                        android:padding="8dp"
                        android:text="Ví điện tử MoMo"
                        android:textColor="@color/md_theme_light_onSurface"
                        android:textSize="12sp" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Empty Cart State -->
    <LinearLayout
        android:id="@+id/layout_cart_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        android:padding="32dp">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_shopping_cart"
            app:tint="@color/md_theme_light_onSurfaceVariant"
            android:contentDescription="Empty cart icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Giỏ hàng của bạn đang trống"
            android:textColor="@color/md_theme_light_onSurface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cart_shop_now"
            style="@style/Widget.DKTechShop.Button.Pill"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:text="Khám phá thiết bị ngay"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="@color/md_theme_light_primary"
            android:textColor="@color/md_theme_light_onPrimary" />
    </LinearLayout>

    <!-- Bottom Checkout Bar -->
    <LinearLayout
        android:id="@+id/layout_checkout_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@color/md_theme_light_surfaceContainer"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tổng thanh toán"
                android:textColor="@color/md_theme_light_onSurfaceVariant"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_cart_total_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0₫"
                android:textColor="@color/md_theme_light_primary"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cart_checkout"
            style="@style/Widget.DKTechShop.Button.Pill"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:text="Đặt hàng"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@color/md_theme_light_primary"
            android:textColor="@color/md_theme_light_onPrimary" />
    </LinearLayout>

</LinearLayout>