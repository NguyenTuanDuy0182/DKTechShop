<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_light_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 1. Top Profile Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/md_theme_light_outlineVariant"
            app:cardBackgroundColor="@color/md_theme_light_surfaceContainerLowest">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:orientation="horizontal">

                <!-- Circular Avatar -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    app:cardCornerRadius="30dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="@color/md_theme_light_primaryContainer">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_person"
                        app:tint="@color/md_theme_light_onPrimaryContainer"
                        android:contentDescription="Avatar" />
                </com.google.android.material.card.MaterialCardView>

                <!-- User Details -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_profile_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Tên người dùng"
                            android:textColor="@color/md_theme_light_onSurface"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btn_profile_edit_name_trigger"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Đổi tên"
                            android:textColor="@color/md_theme_light_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:background="?selectableItemBackgroundBorderless"
                            android:padding="4dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_profile_email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="example@mail.com"
                        android:textColor="@color/md_theme_light_onSurfaceVariant"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Thành viên thân thiết"
                        android:textColor="@color/green_accent"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. Grouped Expandable Menu Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/md_theme_light_outlineVariant"
            app:cardBackgroundColor="@color/md_theme_light_surfaceContainerLowest">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ITEM 1: Đơn mua của tôi -->
                <LinearLayout
                    android:id="@+id/menu_item_orders"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="?selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Đơn mua của tôi"
                        android:textColor="@color/md_theme_light_onSurface"
                        android:textSize="14sp" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/md_theme_light_onSurfaceVariant"
                        android:contentDescription="Arrow" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/md_theme_light_outlineVariant" />

                <!-- ITEM 2: Sổ địa chỉ nhận hàng -->
                <LinearLayout
                    android:id="@+id/menu_item_address_header"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="?selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Địa chỉ"
                        android:textColor="@color/md_theme_light_onSurface"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/iv_arrow_address"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/md_theme_light_onSurfaceVariant"
                        android:contentDescription="Arrow" />
                </LinearLayout>

                <!-- Expanded Address Content -->
                <LinearLayout
                    android:id="@+id/layout_expanded_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/md_theme_light_surfaceContainerLow"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_address_count"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Địa chỉ đã lưu"
                            android:textColor="@color/md_theme_light_onSurfaceVariant"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_toggle_add_address"
                            style="@style/Widget.DKTechShop.Button.Pill"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="+ Thêm địa chỉ"
                            android:textSize="11sp"
                            app:backgroundTint="@color/md_theme_light_primaryContainer"
                            android:textColor="@color/md_theme_light_onPrimaryContainer" />
                    </LinearLayout>

                    <!-- Add Address Form (Hidden by default) -->
                    <LinearLayout
                        android:id="@+id/layout_form_add_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_banner_gradient"
                        android:backgroundTint="@color/md_theme_light_surface"
                        android:padding="12dp"
                        android:visibility="gone"
                        android:orientation="vertical">

                        <EditText
                            android:id="@+id/et_new_address_label"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_banner_gradient"
                            android:backgroundTint="@color/md_theme_light_surfaceContainer"
                            android:hint="Nhãn (VD: Nhà riêng, Công ty)"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/et_new_address_detail"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_banner_gradient"
                            android:backgroundTint="@color/md_theme_light_surfaceContainer"
                            android:hint="Số nhà, đường, Phường, Quận..."
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_save_new_address"
                            style="@style/Widget.DKTechShop.Button.Pill"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="10dp"
                            android:text="Lưu địa chỉ mới"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/md_theme_light_primary"
                            android:textColor="@color/md_theme_light_onPrimary" />
                    </LinearLayout>

                    <!-- List of addresses container -->
                    <LinearLayout
                        android:id="@+id/layout_address_list_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/md_theme_light_outlineVariant" />

                <!-- ITEM 3: Đổi tên người dùng -->
                <LinearLayout
                    android:id="@+id/menu_item_rename_header"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="?selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Đổi tên người dùng"
                        android:textColor="@color/md_theme_light_onSurface"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/iv_arrow_rename"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/md_theme_light_onSurfaceVariant"
                        android:contentDescription="Arrow" />
                </LinearLayout>

                <!-- Expanded Rename Content -->
                <LinearLayout
                    android:id="@+id/layout_expanded_rename"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/md_theme_light_surfaceContainerLow"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tên hiển thị mới"
                        android:textColor="@color/md_theme_light_onSurfaceVariant"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/et_edit_profile_name"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_banner_gradient"
                        android:backgroundTint="@color/md_theme_light_surface"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="Tên người dùng"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Số điện thoại"
                        android:textColor="@color/md_theme_light_onSurfaceVariant"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/et_edit_profile_phone"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_banner_gradient"
                        android:backgroundTint="@color/md_theme_light_surface"
                        android:inputType="phone"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="0123456789"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_save_profile_info"
                        style="@style/Widget.DKTechShop.Button.Pill"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="14dp"
                        android:text="Lưu tên mới"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/md_theme_light_primary"
                        android:textColor="@color/md_theme_light_onPrimary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/md_theme_light_outlineVariant" />

                <!-- ITEM 4: Đổi mật khẩu -->
                <LinearLayout
                    android:id="@+id/menu_item_password_header"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="?selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Đổi mật khẩu"
                        android:textColor="@color/md_theme_light_onSurface"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/iv_arrow_password"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/md_theme_light_onSurfaceVariant"
                        android:contentDescription="Arrow" />
                </LinearLayout>

                <!-- Expanded Password Content -->
                <LinearLayout
                    android:id="@+id/layout_expanded_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/md_theme_light_surfaceContainerLow"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mật khẩu hiện tại"
                        android:textColor="@color/md_theme_light_onSurfaceVariant"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/et_current_password"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_banner_gradient"
                        android:backgroundTint="@color/md_theme_light_surface"
                        android:inputType="textPassword"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Mật khẩu mới (tối thiểu 6 ký tự)"
                        android:textColor="@color/md_theme_light_onSurfaceVariant"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/et_new_password"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_banner_gradient"
                        android:backgroundTint="@color/md_theme_light_surface"
                        android:inputType="textPassword"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Xác nhận mật khẩu mới"
                        android:textColor="@color/md_theme_light_onSurfaceVariant"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/et_confirm_new_password"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_banner_gradient"
                        android:backgroundTint="@color/md_theme_light_surface"
                        android:inputType="textPassword"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_save_password"
                        style="@style/Widget.DKTechShop.Button.Pill"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="14dp"
                        android:text="Cập nhật mật khẩu"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/md_theme_light_primary"
                        android:textColor="@color/md_theme_light_onPrimary" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. Logout Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_profile_logout"
            style="@style/Widget.DKTechShop.Button.OutlinedPill"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:text="Đăng xuất"
            android:textSize="13sp"
            android:textStyle="bold"
            app:strokeColor="@color/md_theme_light_error"
            android:textColor="@color/md_theme_light_error" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>