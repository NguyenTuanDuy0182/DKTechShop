<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/md_theme_light_outlineVariant"
    app:cardBackgroundColor="@color/md_theme_light_surfaceContainerLowest"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Image Box with Discount Badge -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:background="@drawable/bg_banner_gradient"
            android:backgroundTint="@color/md_theme_light_surfaceContainerLow">

            <ImageView
                android:id="@+id/iv_product_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:contentDescription="Product Image" />

            <TextView
                android:id="@+id/tv_discount_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:background="@drawable/bg_banner_gradient"
                android:backgroundTint="@color/md_theme_light_errorContainer"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="-0%"
                android:textColor="@color/md_theme_light_onErrorContainer"
                android:textSize="10sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Brand & Sold Count -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_brand"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Thương hiệu"
                android:textColor="@color/md_theme_light_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_sold_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Đã bán 0"
                android:textColor="@color/md_theme_light_onSurfaceVariant"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Name (2 lines) -->
        <TextView
            android:id="@+id/tv_product_name"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Tên sản phẩm"
            android:textColor="@color/md_theme_light_onSurface"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="@color/md_theme_light_outlineVariant" />

        <!-- Bottom Price and Add Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_original_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0₫"
                    android:textColor="@color/md_theme_light_onSurfaceVariant"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tv_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0₫"
                    android:textColor="@color/md_theme_light_onSurface"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_quick_add"
                style="@style/Widget.DKTechShop.Button.IconButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:icon="@drawable/ic_add"
                app:iconSize="18dp"
                app:iconTint="@color/md_theme_light_onPrimaryContainer"
                app:backgroundTint="@color/md_theme_light_primaryContainer"
                android:contentDescription="Add to cart" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>