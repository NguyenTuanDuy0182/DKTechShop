<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_banner_gradient"
    android:backgroundTint="@color/md_theme_light_surfaceContainerLow"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_banner_gradient"
        android:backgroundTint="@color/md_theme_light_outlineVariant" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Sắp xếp sản phẩm"
            android:textColor="@color/md_theme_light_onSurface"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sort_sheet_close"
            style="@style/Widget.DKTechShop.Button.IconButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="Đóng"
            app:backgroundTint="@color/md_theme_light_surfaceContainerHigh"
            app:icon="@drawable/ic_close"
            app:iconSize="18dp"
            app:iconTint="@color/md_theme_light_onSurfaceVariant" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Chọn tiêu chí hiển thị thiết bị phù hợp với bạn"
        android:textColor="@color/md_theme_light_onSurfaceVariant"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/layout_sort_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical" />

</LinearLayout>
