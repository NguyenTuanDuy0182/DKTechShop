<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_cart_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/md_theme_light_outlineVariant"
    app:cardBackgroundColor="@color/md_theme_light_surfaceContainerLowest">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb_cart_item"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:layout_marginEnd="4dp"
            app:buttonTint="?attr/colorPrimary"
            android:contentDescription="Chọn sản phẩm" />

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_banner_gradient"
            android:backgroundTint="@color/md_theme_light_surfaceContainerLow">

            <ImageView
                android:id="@+id/iv_cart_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_devices"
                app:tint="@color/md_theme_light_primary"
                android:contentDescription="Cart product thumbnail" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_cart_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Tên SP"
                android:textColor="@color/md_theme_light_onSurface"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_cart_variant"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Mô tả"
                android:textColor="@color/md_theme_light_onSurfaceVariant"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_cart_price"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0₫"
                    android:textColor="@color/md_theme_light_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Stepper -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_banner_gradient"
                    android:backgroundTint="@color/md_theme_light_surfaceContainer"
                    android:gravity="center_vertical"
                    android:padding="2dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_cart_minus"
                        style="@style/Widget.DKTechShop.Button.IconButton"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        app:icon="@drawable/ic_remove"
                        app:iconSize="14dp"
                        app:iconTint="@color/md_theme_light_onSurface"
                        app:backgroundTint="@color/md_theme_light_surface"
                        android:contentDescription="Decrease quantity" />

                    <TextView
                        android:id="@+id/tv_cart_qty"
                        android:layout_width="26dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="@color/md_theme_light_onSurface"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_cart_plus"
                        style="@style/Widget.DKTechShop.Button.IconButton"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        app:icon="@drawable/ic_add"
                        app:iconSize="14dp"
                        app:iconTint="@color/md_theme_light_onPrimaryContainer"
                        app:backgroundTint="@color/md_theme_light_primaryContainer"
                        android:contentDescription="Increase quantity" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>